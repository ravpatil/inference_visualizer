import { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Cpu, Server, Layers, Database, Play, RotateCcw } from 'lucide-react';

const SCENES = [
  { id: 1, title: "1. Cluster Overview", desc: "OpenShift AI Cluster with KServe & vLLM runtime (Idle)" },
  { id: 2, title: "2. Request Arrives", desc: "Client sends 'Hello!' request to KServe Gateway" },
  { id: 3, title: "3. Tokenization", desc: "String split into discrete token packets: [Hello] and [!]" },
  { id: 4, title: "4. Prefill Phase", desc: "Tokens process through all 32 transformer layers simultaneously" },
  { id: 5, title: "5. KV Cache Creation", desc: "Key-Value vectors are extracted and saved to GPU memory" },
  { id: 6, title: "6. Decode Phase Begins", desc: "Switching execution modes. Model shifts to autoregressive state" },
  { id: 7, title: "7. KV Cache Reuse", desc: "Saved context feeds back into attention layers; no recomputation!" },
  { id: 8, title: "8. First Generated Token", desc: "Model predicts next token: 'world' and streams it to client" },
  { id: 9, title: "9. Continuous Decode", desc: "Final token '!' predicted and streamed. Stream closing." },
  { id: 10, title: "10. Metrics Complete", desc: "Final performance profiling calculated by vLLM engine" }
];

export default function App() {
  const [scene, setScene] = useState(1);

  // Keyboard navigation for presentation clickers / arrows
  useEffect(() => {
    const handleKeyDown = (e) => {
      if (e.key === 'ArrowRight' || e.key === ' ') setScene(s => Math.min(s + 1, 10));
      if (e.key === 'ArrowLeft') setScene(s => Math.max(s - 1, 1));
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, []);

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col justify-between p-6 select-none select-none font-mono">
      
      {/* Top Banner Control Panel */}
      <div className="flex justify-between items-center bg-slate-900 p-4 rounded-xl border border-slate-800 shadow-xl">
        <div>
          <h1 className="text-xl font-bold text-blue-400">vLLM Execution Lifecycle Demo</h1>
          <p className="text-xs text-slate-400">{SCENES[scene - 1].title}: {SCENES[scene - 1].desc}</p>
        </div>
        <div className="flex gap-2">
          <button 
            onClick={() => setScene(s => Math.max(s - 1, 1))}
            className="px-3 py-1 bg-slate-800 hover:bg-slate-700 rounded text-sm transition"
          >
            ◀ Back
          </button>
          <div className="px-4 py-1 bg-slate-950 border border-slate-700 rounded text-sm text-yellow-400 font-bold flex items-center">
            Scene {scene} / 10
          </div>
          <button 
            onClick={() => setScene(s => Math.min(s + 1, 10))}
            className="px-3 py-1 bg-blue-600 hover:bg-blue-500 rounded text-sm transition font-bold"
          >
            Next (Space) ▶
          </button>
          <button 
            onClick={() => setScene(1)} 
            className="p-1 bg-slate-800 hover:bg-slate-700 rounded text-slate-400"
            title="Reset"
          >
            <RotateCcw size={18} />
          </button>
        </div>
      </div>

      {/* Main Canvas Dashboard Layout */}
      <div className="grid grid-cols-4 gap-6 my-6 flex-grow items-stretch">
        
        {/* Architecture Flow Field (Left 3 Columns) */}
        <div className="col-span-3 bg-slate-900/50 rounded-xl border border-slate-800 p-6 relative flex flex-col justify-between overflow-hidden">
          
          {/* Client Node */}
          <div className="flex flex-col items-center">
            <div className="px-6 py-3 bg-slate-800 rounded-lg border border-slate-700 shadow-md flex items-center gap-3 z-10">
              <Cpu className="text-indigo-400" size={20} />
              <div>
                <div className="text-xs text-slate-400 font-bold">CLIENT NODE</div>
                <div className="text-sm font-semibold text-white">Prompt: "Hello!"</div>
              </div>
            </div>
            
            {/* Stream output rendering directly on client */}
            {scene >= 8 && (
              <motion.div 
                initial={{ opacity: 0, y: -10 }} 
                animate={{ opacity: 1, y: 0 }}
                className="mt-2 text-green-400 font-bold bg-slate-950 border border-green-900 px-3 py-1 rounded text-xs"
              >
                Stream: Hello{scene >= 8 ? ' world' : ''}{scene >= 9 ? '!' : ''}
              </motion.div>
            )}
          </div>

          {/* Dynamic Interactive Flow Network */}
          <div className="relative h-48 flex justify-center items-center">
            {/* Static background pipeline path */}
            <div className="absolute w-[2px] h-full bg-slate-800 left-1/2 -translate-x-1/2 top-0 z-0" />

            {/* Scene 2: Flying Packet String */}
            {scene === 2 && (
              <motion.div 
                initial={{ y: -80, opacity: 0 }}
                animate={{ y: 80, opacity: 1 }}
                transition={{ repeat: Infinity, duration: 1.5, ease: "linear" }}
                className="absolute px-3 py-1 bg-blue-500 text-white rounded text-xs font-bold shadow-lg shadow-blue-500/50 z-20"
              >
                "Hello!"
              </motion.div>
            )}

            {/* Scene 3+: Splitting Exploded Token Packets */}
            {scene >= 3 && (
              <div className="flex gap-4 z-20">
                <AnimatePresence>
                  <motion.div 
                    animate={
                      scene === 4 ? { y: 110, scale: 0.9, backgroundColor: "#3b82f6" } : 
                      scene === 5 ? { x: 260, y: 150, scale: 0.8, backgroundColor: "#a855f7" } : 
                      scene >= 6 ? { opacity: 0 } : { y: 0 }
                    }
                    transition={{ type: "spring", stiffness: 60 }}
                    className="px-3 py-1.5 bg-cyan-600 rounded text-xs font-bold border border-cyan-400 shadow-md"
                  >
                    [Hello]
                  </motion.div>
                  <motion.div 
                    animate={
                      scene === 4 ? { y: 110, scale: 0.9, backgroundColor: "#3b82f6" } : 
                      scene === 5 ? { x: 260, y: 150, scale: 0.8, backgroundColor: "#a855f7" } : 
                      scene >= 6 ? { opacity: 0 } : { y: 0 }
                    }
                    transition={{ type: "spring", stiffness: 60, delay: 0.1 }}
                    className="px-3 py-1.5 bg-teal-600 rounded text-xs font-bold border border-teal-400 shadow-md"
                  >
                    [!]
                  </motion.div>
                </AnimatePresence>
              </div>
            )}

            {/* Scene 6+: Decode phase step-by-step isolated dynamic tokens */}
            {scene === 6 && (
              <motion.div initial={{ scale: 0 }} animate={{ scale: 1 }} className="absolute text-yellow-400 text-xs font-bold bg-slate-950 p-2 border border-yellow-700 rounded z-20">
                ⚡ Initializing Loop...
              </motion.div>
            )}
            {scene === 8 && (
              <motion.div initial={{ y: 60 }} animate={{ y: -100 }} transition={{ repeat: Infinity, duration: 1.2 }} className="absolute px-3 py-1 bg-green-500 text-slate-950 text-xs font-bold rounded shadow-lg z-20">
                Token: "world"
              </motion.div>
            )}
            {scene === 9 && (
              <motion.div initial={{ y: 60 }} animate={{ y: -100 }} transition={{ repeat: Infinity, duration: 1.2 }} className="absolute px-3 py-1 bg-green-500 text-slate-950 text-xs font-bold rounded shadow-lg z-20">
                Token: "!"
              </motion.div>
            )}
          </div>

          {/* KServe Mesh Gateway Wrapper */}
          <div className="flex flex-col items-center mb-4">
            <div className="px-6 py-2 bg-slate-800 rounded-lg border border-slate-700 shadow-md flex items-center gap-3 z-10 w-64 justify-center">
              <Server className="text-cyan-400" size={18} />
              <div className="text-center">
                <div className="text-[10px] text-slate-400 font-bold">KSERVE GATEWAY</div>
                <div className="text-xs text-slate-300">Routing to vLLM</div>
              </div>
            </div>
          </div>

          {/* OpenShift AI / GPU Pod Execution Node Box */}
          <div className="border border-dashed border-slate-700 bg-slate-900/80 rounded-xl p-4 relative grid grid-cols-3 gap-4">
            <div className="absolute top-[-10px] left-4 bg-slate-950 px-2 py-0.5 border border-slate-800 rounded text-[9px] text-slate-400 font-bold tracking-widest">
              CONTAINER POD (vLLM ENGINE)
            </div>

            {/* Transformer Execution Core Stack (2/3 columns) */}
            <div className="col-span-2 bg-slate-950/80 p-3 rounded-lg border border-slate-800 flex flex-col justify-between h-44">
              <div className="flex justify-between items-center border-b border-slate-800 pb-1 mb-1">
                <div className="flex items-center gap-1.5 text-xs text-blue-400 font-bold">
                  <Layers size={14} /> Attention Stack (Llama 3.1)
                </div>
                <div className={`text-[10px] px-2 py-0.5 rounded font-bold ${scene <= 5 ? 'bg-blue-950 text-blue-400' : 'bg-green-950 text-green-400'}`}>
                  Mode: {scene <= 5 ? 'Prefill' : 'Decode'}
                </div>
              </div>

              {/* Graphical Layers rendering */}
              <div className="space-y-1 flex-grow flex flex-col justify-center">
                {[1, 2, 3, 32].map((layer, idx) => (
                  <div key={layer} className="relative">
                    {layer === 32 && <div className="text-center text-[8px] text-slate-600 my-0.5">••• [Layers 4-31 hidden] •••</div>}
                    <motion.div 
                      animate={{
                        backgroundColor: scene === 4 ? ["#1e293b", "#2563eb", "#1e293b"] : scene >= 7 && scene <= 9 ? ["#1e293b", "#16a34a", "#1e293b"] : "#1e293b",
                        borderColor: scene === 4 ? "#3b82f6" : scene >= 7 && scene <= 9 ? "#22c55e" : "#334155"
                      }}
                      transition={{ repeat: Infinity, duration: 1.5, delay: idx * 0.2 }}
                      className="h-5 border rounded text-[9px] flex items-center justify-between px-3 text-slate-400"
                    >
                      <span>Layer {layer}</span>
                      {scene === 4 && <span className="text-blue-400 animate-pulse text-[8px]">Parallel Dot-Product Matrix Active</span>}
                      {(scene === 7 || scene === 8 || scene === 9) && <span className="text-green-400 text-[8px]">Cache Context Hit</span>}
                    </motion.div>
                  </div>
                ))}
              </div>
            </div>

            {/* Stateful KV Cache Sidecar Component (1/3 column) */}
            <div className="bg-slate-950/80 p-3 rounded-lg border border-slate-800 flex flex-col justify-between h-44 relative">
              <div className="flex items-center gap-1.5 text-xs text-purple-400 font-bold border-b border-slate-800 pb-1">
                <Database size={14} /> KV Cache Store
              </div>

              {/* Cache rows rendering */}
              <div className="flex-grow flex flex-col justify-center gap-1.5 mt-2">
                {scene >= 5 ? (
                  <>
                    <motion.div initial={{ scale: 0 }} animate={{ scale: 1 }} className="bg-purple-950/60 border border-purple-800 rounded p-1 text-[9px] text-purple-300 text-center font-bold">
                      K_pos[0-4] → V_pos[0-4] (Hello)
                    </motion.div>
                    <motion.div initial={{ scale: 0 }} animate={{ scale: 1 }} transition={{ delay: 0.1 }} className="bg-purple-950/60 border border-purple-800 rounded p-1 text-[9px] text-purple-300 text-center font-bold">
                      K_pos[5] → V_pos[5] (!)
                    </motion.div>
                    {scene >= 8 && (
                      <motion.div initial={{ scale: 0 }} animate={{ scale: 1 }} className="bg-green-950/60 border border-green-800 rounded p-1 text-[9px] text-green-300 text-center font-bold">
                        + K_gen[6] → V_gen[6] (world)
                      </motion.div>
                    )}
                  </>
                ) : (
                  <div className="text-slate-600 text-center text-[10px] italic py-8">Unallocated<br/>(Awaiting Prefill)</div>
                )}
              </div>
              
              {/* Dynamic connection lines back to attention layers during decode */}
              {scene >= 7 && scene <= 9 && (
                <motion.div 
                  animate={{ opacity: [0.3, 1, 0.3] }} 
                  transition={{ repeat: Infinity, duration: 1 }}
                  className="absolute left-[-15px] top-1/2 w-4 h-[2px] bg-purple-500 z-30 hidden md:block" 
                />
              )}
            </div>

          </div>
        </div>

        {/* Live Observability Engine Dashboard (Right 1 Column) */}
        <div className="bg-slate-900 border border-slate-800 rounded-xl p-4 flex flex-col justify-between shadow-2xl">
          <div className="space-y-4">
            <div className="text-xs font-bold text-slate-400 tracking-widest border-b border-slate-800 pb-2 flex items-center justify-between">
              <span>vLLM METRICS TRACE</span>
              <span className="w-2 h-2 rounded-full bg-green-500 animate-ping"/>
            </div>

            {/* PREFILL SCOPE METRICS */}
            <div className="space-y-1 bg-slate-950 p-2 rounded border border-slate-800">
              <div className="text-[10px] text-blue-400 font-bold">PHASE: PREFILL</div>
              <div className="flex justify-between text-xs">
                <span className="text-slate-500">Input Tokens:</span>
                <span className={scene >= 3 ? "text-white" : "text-slate-600"}>{scene >= 3 ? "2" : "0"}</span>
              </div>
              <div className="flex justify-between text-xs">
                <span className="text-slate-500">TTFT Latency:</span>
                <span className="text-blue-400 font-bold">{scene >= 4 ? "85 ms" : "--"}</span>
              </div>
            </div>

            {/* DECODE SCOPE METRICS */}
            <div className="space-y-1 bg-slate-950 p-2 rounded border border-slate-800">
              <div className="text-[10px] text-green-400 font-bold">PHASE: DECODE</div>
              <div className="flex justify-between text-xs">
                <span className="text-slate-500">Generated Tokens:</span>
                <span className="text-white">
                  {scene === 8 ? "1" : scene >= 9 ? "2" : "0"}
                </span>
              </div>
              <div className="flex justify-between text-xs">
                <span className="text-slate-500">Throughput Rate:</span>
                <span className="text-green-400 font-bold">{scene >= 8 ? "72 tok/s" : "--"}</span>
              </div>
            </div>

            {/* HARWARE PROFILE */}
            <div className="space-y-1 bg-slate-950 p-2 rounded border border-slate-800">
              <div className="text-[10px] text-amber-500 font-bold">GPU ACCELERATOR PROFILE</div>
              <div className="flex justify-between text-xs">
                <span className="text-slate-500">Engine Core Util:</span>
                <span className="text-white">{scene === 4 ? "98%" : scene >= 7 && scene <= 9 ? "42%" : "2%"}</span>
              </div>
              <div className="flex justify-between text-xs">
                <span className="text-slate-500">KV Cache Memory:</span>
                <span className="text-purple-400">{scene >= 5 ? "12.4 MB" : "0 MB"}</span>
              </div>
            </div>
          </div>

          <div className="text-[10px] bg-slate-950 p-2 rounded text-slate-500 text-center border border-slate-800">
            Use your presentation clicker or <span className="text-slate-300 font-bold">Left/Right Arrows</span> to scrub execution state.
          </div>
        </div>

      </div>
    </div>
  );
}